{
    "services": {
        "airport-lookup": {
            "name": "airport-lookup",
            "functions": {
                "init": {
                    "filepath": "/functions/data/init.wasm",
                    "pool_size": 1
                },
                "seed": {
                    "filepath": "/functions/data/seed.wasm",
                    "pool_size": 1
                }
            },
            "routes": [
                {
                    "type": "init",
                    "function": "init"
                },
                {
                    "type": "scheduled_task",
                    "function": "seed",
                    "frequency": 3600
                },
                {
                    "type": "function",
                    "function": "seed"
                }
            ]
        }
    }
}
